# Backend environment example
# Copy this file to backend/.env and replace the placeholder values.
# Do not commit backend/.env because it contains secrets.

# Server
NODE_ENV=development
PORT=5000

# Database - MongoDB Atlas
# MongoDB Compass is only a GUI. Use Atlas so every laptop and deployment
# can connect to the same cloud database.
# Get this from Atlas > Database > Connect > Drivers.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/letsfixcampus

# Authentication
# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRE=7d

# College settings
COLLEGE_EMAIL_DOMAIN=@grietcollege.com

# Image uploads
# Use local for development. Use cloudinary when deploying.
UPLOAD_METHOD=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Poll automation
# 0 = Sunday, 6 = Saturday
POLL_DAY=6
POLL_START_HOUR=0
